# Local real-provider configuration only.
# Copy to .env, fill only the providers you use, and never commit real keys.
#
# Provider discovery reads <PREFIX>_API_KEY and <PREFIX>_BASE_URL.
# Model names come from configs/model_profiles/*.yaml by default; the *_MODEL
# and *_MODEL_PROFILE variables below are optional overrides.

# OpenAI-compatible OpenAI endpoint
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
# OPENAI_MODEL=
# OPENAI_MODEL_PROFILE=openai_gpt56_sol

# Qwen / DashScope OpenAI-compatible endpoint
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-plus
# QWEN_MODEL_PROFILE=qwen

# Kimi / Moonshot OpenAI-compatible endpoint
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
# KIMI_MODEL=kimi-k3
# KIMI_MODEL_PROFILE=kimi

# DeepSeek OpenAI-compatible endpoint
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-pro
# DEEPSEEK_MODEL_PROFILE=deepseek

# Optional global throttling for live-provider calls.
# LLM_REQUEST_SLEEP_SECONDS=0
